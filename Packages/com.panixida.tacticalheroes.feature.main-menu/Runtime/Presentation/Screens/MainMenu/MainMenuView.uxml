<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Typography/Typography.uss" />
    <Style src="../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Components/DecorativePanel/DecorativePanel.uss" />
    <Style src="MainMenuView.uss" />
    <ui:Template name="DecorativePanelChrome" src="../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Components/DecorativePanel/DecorativePanelChrome.uxml" />
    <ui:VisualElement name="menu-root" class="screen menu-root">
        <ui:VisualElement class="menu-dark-overlay" />

        <ui:VisualElement class="menu-panel th-panel">
            <ui:Instance template="DecorativePanelChrome" class="th-panel-chrome" />

            <ui:VisualElement name="menu-logo" class="menu-logo" />

            <ui:VisualElement class="menu-title-stack">
                <ui:Label class="menu-title-layer menu-title-shadow typography-display-main-title" text="TACTICAL HEROES" />
                <ui:Label class="menu-title-layer menu-title-glow typography-display-main-title" text="TACTICAL HEROES" />
                <ui:Label name="menu-title" class="menu-title-layer menu-title-main typography-display-main-title" text="TACTICAL HEROES" />
                <ui:Label class="menu-title-layer menu-title-highlight typography-display-main-title" text="TACTICAL HEROES" />
            </ui:VisualElement>
            <ui:VisualElement class="title-separator" />
            <ui:Label class="menu-subtitle" text="Forge your legend across a shattered realm" />

            <ui:Button name="single-player-button" class="menu-button selected">
                <ui:VisualElement class="button-tint" />
                <ui:VisualElement class="button-selected-glow" />
                <ui:VisualElement class="menu-button-label-stack">
                    <ui:Label class="menu-button-label-layer menu-button-label-shadow typography-controls-large-button-label" text="SINGLE PLAYER" />
                    <ui:Label class="menu-button-label-layer menu-button-label-glow typography-controls-large-button-label" text="SINGLE PLAYER" />
                    <ui:Label class="menu-button-label-layer menu-button-label menu-button-label-source typography-controls-large-button-label" text="SINGLE PLAYER" />
                    <ui:Label class="menu-button-label-layer menu-button-label-highlight typography-controls-large-button-label" text="SINGLE PLAYER" />
                </ui:VisualElement>
            </ui:Button>
            <ui:Button name="multiplayer-button" class="menu-button">
                <ui:VisualElement class="button-tint" />
                <ui:VisualElement class="button-selected-glow" />
                <ui:VisualElement class="menu-button-label-stack">
                    <ui:Label class="menu-button-label-layer menu-button-label-shadow typography-controls-large-button-label" text="MULTIPLAYER" />
                    <ui:Label class="menu-button-label-layer menu-button-label-glow typography-controls-large-button-label" text="MULTIPLAYER" />
                    <ui:Label class="menu-button-label-layer menu-button-label menu-button-label-source typography-controls-large-button-label" text="MULTIPLAYER" />
                    <ui:Label class="menu-button-label-layer menu-button-label-highlight typography-controls-large-button-label" text="MULTIPLAYER" />
                </ui:VisualElement>
            </ui:Button>
            <ui:Button name="hero-creation-button" class="menu-button">
                <ui:VisualElement class="button-tint" />
                <ui:VisualElement class="button-selected-glow" />
                <ui:VisualElement class="menu-button-label-stack">
                    <ui:Label class="menu-button-label-layer menu-button-label-shadow typography-controls-large-button-label" text="HERO CREATION" />
                    <ui:Label class="menu-button-label-layer menu-button-label-glow typography-controls-large-button-label" text="HERO CREATION" />
                    <ui:Label class="menu-button-label-layer menu-button-label menu-button-label-source typography-controls-large-button-label" text="HERO CREATION" />
                    <ui:Label class="menu-button-label-layer menu-button-label-highlight typography-controls-large-button-label" text="HERO CREATION" />
                </ui:VisualElement>
            </ui:Button>
            <ui:Button name="settings-button" class="menu-button">
                <ui:VisualElement class="button-tint" />
                <ui:VisualElement class="button-selected-glow" />
                <ui:VisualElement class="menu-button-label-stack">
                    <ui:Label class="menu-button-label-layer menu-button-label-shadow typography-controls-large-button-label" text="SETTINGS" />
                    <ui:Label class="menu-button-label-layer menu-button-label-glow typography-controls-large-button-label" text="SETTINGS" />
                    <ui:Label class="menu-button-label-layer menu-button-label menu-button-label-source typography-controls-large-button-label" text="SETTINGS" />
                    <ui:Label class="menu-button-label-layer menu-button-label-highlight typography-controls-large-button-label" text="SETTINGS" />
                </ui:VisualElement>
            </ui:Button>
            <ui:Button name="exit-button" class="menu-button">
                <ui:VisualElement class="button-tint" />
                <ui:VisualElement class="button-selected-glow" />
                <ui:VisualElement class="menu-button-label-stack">
                    <ui:Label class="menu-button-label-layer menu-button-label-shadow typography-controls-large-button-label" text="EXIT" />
                    <ui:Label class="menu-button-label-layer menu-button-label-glow typography-controls-large-button-label" text="EXIT" />
                    <ui:Label class="menu-button-label-layer menu-button-label menu-button-label-source typography-controls-large-button-label" text="EXIT" />
                    <ui:Label class="menu-button-label-layer menu-button-label-highlight typography-controls-large-button-label" text="EXIT" />
                </ui:VisualElement>
            </ui:Button>

            <ui:VisualElement class="footer-ornament footer-ornament-left" />
            <ui:VisualElement class="footer-ornament footer-ornament-right" />
            <ui:Label class="version-label" text="PRE-ALPHA v0.1.0" />
        </ui:VisualElement>

        <ui:VisualElement class="footer-links">
            <ui:Button name="discord-button" class="icon-button icon-button-discord" />
            <ui:Button name="support-button" class="icon-button icon-button-support" />
            <ui:Button name="footer-settings-button" class="icon-button icon-button-settings" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
