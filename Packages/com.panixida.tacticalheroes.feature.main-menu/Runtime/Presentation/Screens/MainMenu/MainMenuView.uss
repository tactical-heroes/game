.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 260ms;
    transition-timing-function: ease-in-out;
}

.screen-hidden {
    opacity: 0;
    translate: 0 18px;
}

.menu-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: #080705;
    background-image: url("../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Images/menu_background.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.menu-dark-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.10);
    picking-mode: ignore;
}

.menu-panel {
    position: absolute;
    top: 26px;
    right: 28px;
    width: 610px;
    height: 1028px;
}

.menu-logo {
    position: absolute;
    left: 205px;
    top: 56px;
    width: 200px;
    height: 200px;
    background-image: url("../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Images/menu_logo_emblem.png");
    -unity-background-scale-mode: scale-to-fit;
    picking-mode: ignore;
}

.menu-title-stack {
    position: absolute;
    left: 40px;
    top: 286px;
    width: 530px;
    height: 88px;
    picking-mode: ignore;
}

.menu-title-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 530px;
    height: 78px;
    font-size: 46px;
    -unity-font-definition: url("../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Fonts/Cinzel-Bold.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    letter-spacing: 1.84px;
}

.menu-title-shadow {
    left: 3px;
    top: 6px;
    width: 524px;
    color: rgba(18, 7, 3, 0.90);
}

.menu-title-glow {
    color: rgba(255, 179, 31, 0.24);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(255, 179, 31, 0.18);
    text-shadow: 0 0 7px rgba(255, 179, 31, 0.24);
}

.menu-title-main {
    color: #d69b2d;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(255, 218, 86, 0.22);
    text-shadow: 0 4px 6px rgba(0, 0, 0, 0.78);
}

.menu-title-highlight {
    top: -1px;
    color: rgba(255, 242, 173, 0.52);
}

.title-separator {
    position: absolute;
    left: 58px;
    top: 350px;
    width: 494px;
    height: 50px;
    background-image: url("../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Images/menu_title_separator.png");
    -unity-background-scale-mode: stretch-to-fill;
    picking-mode: ignore;
}

.menu-subtitle {
    position: absolute;
    left: 58px;
    top: 393px;
    width: 494px;
    height: 30px;
    color: #dbc28f;
    font-size: 20px;
    -unity-font-definition: url("../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Fonts/CormorantGaramond-Medium.otf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    letter-spacing: 0.6px;
    picking-mode: ignore;
}

.menu-button {
    position: absolute;
    left: 58px;
    width: 494px;
    height: 80px;
}

.menu-button .th-button__label-layer {
    font-size: 28px;
    -unity-font-definition: url("../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Fonts/CormorantGaramond-SemiBold.otf");
    -unity-font-style: normal;
    letter-spacing: 2.52px;
}

#single-player-button {
    top: 430px;
}

#multiplayer-button {
    top: 512px;
}

#hero-creation-button {
    top: 594px;
}

#settings-button {
    top: 676px;
}

#exit-button {
    top: 758px;
}

.footer-ornament {
    position: absolute;
    bottom: 18px;
    width: 150px;
    height: 36px;
    background-image: url("Images/menu_footer_ornament.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: #ffffff;
    picking-mode: ignore;
}

.footer-ornament-left {
    left: 104px;
}

.footer-ornament-right {
    left: 356px;
}

.version-label {
    position: absolute;
    left: 210px;
    top: 970px;
    width: 190px;
    height: 36px;
    color: #dbb87a;
    font-size: 14px;
    -unity-font-definition: url("../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Fonts/Cinzel-Regular.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    letter-spacing: 0.98px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.55);
    picking-mode: ignore;
}

.footer-links {
    position: absolute;
    left: 50px;
    bottom: 36px;
    width: 190px;
    height: 58px;
    flex-direction: row;
}

.icon-button {
    position: absolute;
    top: 0;
    width: 54px;
    height: 54px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.icon-button:hover {
    background-color: rgba(255, 194, 71, 0.12);
}

.icon-button:active {
    background-color: rgba(255, 194, 71, 0.24);
}

.icon-button-discord {
    left: 0;
    background-image: url("Images/menu_icon_discord.png");
}

.icon-button-support {
    left: 68px;
    background-image: url("Images/menu_icon_support.png");
}

.icon-button-settings {
    left: 136px;
    background-image: url("Images/menu_icon_settings.png");
}
