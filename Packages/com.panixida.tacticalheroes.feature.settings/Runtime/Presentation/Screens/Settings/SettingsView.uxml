<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:foundation="Panixida.TacticalHeroes.Foundation.Presentation.Components" editor-extension-mode="False">
    <Style src="../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Typography/Typography.uss" />
    <Style src="../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Components/DecorativePanel/DecorativePanel.uss" />
    <Style src="../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Components/GameButton/GameButtonView.uss" />
    <Style src="SettingsView.uss" />
    <ui:Template name="DecorativePanelChrome" src="../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Components/DecorativePanel/DecorativePanelChrome.uxml" />
    <ui:VisualElement name="settings-root" class="screen settings-root screen-hidden">
        <ui:VisualElement class="settings-dark-overlay" />

        <ui:VisualElement class="settings-logo" />
        <ui:Label class="settings-title-shadow typography-display-main-title" text="SETTINGS" />
        <ui:Label class="settings-title typography-display-main-title" text="SETTINGS" />
        <ui:VisualElement class="settings-title-separator" />
        <ui:Label class="settings-subtitle" text="Customize your experience" />

        <ui:VisualElement class="settings-navigation th-panel">
            <ui:Instance template="DecorativePanelChrome" class="th-panel-chrome" />
            <foundation:GameButtonView name="settings-navigation-general-button" class="settings-navigation-button" label="GENERAL" selected="true" />
        </ui:VisualElement>

        <ui:VisualElement class="settings-panels">
            <ui:VisualElement class="settings-card settings-card-large settings-card-display th-panel">
                <ui:Instance template="DecorativePanelChrome" class="th-panel-chrome" />
                <ui:Label class="settings-card-title" text="DISPLAY" />
                <ui:VisualElement class="settings-title-rule settings-title-rule-left" />
                <ui:VisualElement class="settings-title-rule settings-title-rule-right" />

                <ui:VisualElement class="settings-row row-1">
                    <ui:VisualElement class="settings-row-icon icon-resolution" />
                    <ui:Label class="settings-row-label" text="Resolution" />
                    <ui:Button class="settings-dropdown">
                        <ui:Label class="settings-dropdown-value" text="1920x1080 (16:9)" />
                        <ui:VisualElement class="settings-dropdown-arrow" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="settings-row-divider divider-1" />
                <ui:VisualElement class="settings-row row-2">
                    <ui:VisualElement class="settings-row-icon icon-display-mode" />
                    <ui:Label class="settings-row-label" text="Display Mode" />
                    <ui:Button class="settings-dropdown">
                        <ui:Label class="settings-dropdown-value" text="Fullscreen" />
                        <ui:VisualElement class="settings-dropdown-arrow" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="settings-row-divider divider-2" />
                <ui:VisualElement class="settings-row row-3">
                    <ui:VisualElement class="settings-row-icon icon-frame-rate" />
                    <ui:Label class="settings-row-label" text="Max Frame Rate" />
                    <ui:Button class="settings-dropdown">
                        <ui:Label class="settings-dropdown-value" text="120 FPS" />
                        <ui:VisualElement class="settings-dropdown-arrow" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="settings-row-divider divider-3" />
                <ui:VisualElement class="settings-row row-4">
                    <ui:VisualElement class="settings-row-icon icon-brightness" />
                    <ui:Label class="settings-row-label" text="Brightness" />
                    <ui:VisualElement class="settings-slider">
                        <ui:VisualElement class="settings-slider-track" />
                        <ui:VisualElement class="settings-slider-fill fill-75" />
                        <ui:VisualElement class="settings-value-box">
                            <ui:Label class="settings-value-text" text="75%" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="settings-card settings-card-large settings-card-quality th-panel">
                <ui:Instance template="DecorativePanelChrome" class="th-panel-chrome" />
                <ui:Label class="settings-card-title" text="QUALITY" />
                <ui:VisualElement class="settings-title-rule settings-title-rule-left" />
                <ui:VisualElement class="settings-title-rule settings-title-rule-right" />

                <ui:VisualElement class="settings-row quality-row-1">
                    <ui:VisualElement class="settings-row-icon icon-quality" />
                    <ui:Label class="settings-row-label" text="Overall Quality" />
                    <ui:Button class="settings-dropdown">
                        <ui:Label class="settings-dropdown-value" text="High" />
                        <ui:VisualElement class="settings-dropdown-arrow" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="settings-row-divider quality-divider-1" />
                <ui:VisualElement class="settings-row quality-row-2">
                    <ui:VisualElement class="settings-row-icon icon-textures" />
                    <ui:Label class="settings-row-label" text="Textures" />
                    <ui:Button class="settings-dropdown">
                        <ui:Label class="settings-dropdown-value" text="High" />
                        <ui:VisualElement class="settings-dropdown-arrow" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="settings-row-divider quality-divider-2" />
                <ui:VisualElement class="settings-row quality-row-3">
                    <ui:VisualElement class="settings-row-icon icon-effects" />
                    <ui:Label class="settings-row-label" text="Effects Quality" />
                    <ui:Button class="settings-dropdown">
                        <ui:Label class="settings-dropdown-value" text="High" />
                        <ui:VisualElement class="settings-dropdown-arrow" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="settings-card settings-card-small settings-card-audio th-panel">
                <ui:Instance template="DecorativePanelChrome" class="th-panel-chrome" />
                <ui:Label class="settings-card-title" text="AUDIO" />
                <ui:VisualElement class="settings-title-rule settings-title-rule-left" />
                <ui:VisualElement class="settings-title-rule settings-title-rule-right" />

                <ui:VisualElement class="settings-row audio-row-1">
                    <ui:VisualElement class="settings-row-icon icon-music" />
                    <ui:Label class="settings-row-label" text="Music Volume" />
                    <ui:VisualElement class="settings-slider">
                        <ui:VisualElement class="settings-slider-track" />
                        <ui:VisualElement class="settings-slider-fill fill-72" />
                        <ui:VisualElement class="settings-value-box">
                            <ui:Label class="settings-value-text" text="72%" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="settings-row-divider audio-divider-1" />
                <ui:VisualElement class="settings-row audio-row-2">
                    <ui:VisualElement class="settings-row-icon icon-effects-volume" />
                    <ui:Label class="settings-row-label" text="Effects Volume" />
                    <ui:VisualElement class="settings-slider">
                        <ui:VisualElement class="settings-slider-track" />
                        <ui:VisualElement class="settings-slider-fill fill-85" />
                        <ui:VisualElement class="settings-value-box">
                            <ui:Label class="settings-value-text" text="85%" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="settings-card settings-card-small settings-card-gameplay th-panel">
                <ui:Instance template="DecorativePanelChrome" class="th-panel-chrome" />
                <ui:Label class="settings-card-title" text="GAMEPLAY" />
                <ui:VisualElement class="settings-title-rule settings-title-rule-left" />
                <ui:VisualElement class="settings-title-rule settings-title-rule-right" />

                <ui:VisualElement class="settings-row gameplay-row-1">
                    <ui:VisualElement class="settings-row-icon icon-language" />
                    <ui:Label class="settings-row-label" text="Language" />
                    <ui:Button class="settings-dropdown">
                        <ui:Label class="settings-dropdown-value" text="English" />
                        <ui:VisualElement class="settings-dropdown-arrow" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="settings-row-divider gameplay-divider-1" />
                <ui:VisualElement class="settings-row gameplay-row-2">
                    <ui:VisualElement class="settings-row-icon icon-damage" />
                    <ui:Label class="settings-row-label" text="Show Damage Numbers" />
                    <ui:Button class="settings-toggle selected">
                        <ui:Label class="settings-toggle-label" text="ON" />
                        <ui:VisualElement class="settings-toggle-knob" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="settings-footer-actions">
            <foundation:GameButtonView name="settings-back-button" class="settings-action-button" label="BACK" />
            <foundation:GameButtonView name="settings-restore-defaults-button" class="settings-action-button" label="RESTORE DEFAULTS" />
            <foundation:GameButtonView name="settings-apply-button" class="settings-action-button" label="APPLY" />
            <foundation:GameButtonView name="settings-cancel-button" class="settings-action-button" label="CANCEL" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
