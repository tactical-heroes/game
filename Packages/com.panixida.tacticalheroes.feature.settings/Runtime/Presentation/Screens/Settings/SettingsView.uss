.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 260ms;
    transition-timing-function: ease-in-out;
}

.screen-hidden {
    opacity: 0;
    translate: 0 18px;
}

.settings-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: #050403;
    background-image: url("../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Images/menu_background.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.settings-dark-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.18);
}

.settings-logo {
    position: absolute;
    left: 910px;
    top: 12px;
    width: 100px;
    height: 100px;
    background-image: url("../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Images/menu_logo_emblem.png");
    -unity-background-scale-mode: scale-to-fit;
}

.settings-title-shadow {
    position: absolute;
    left: 698px;
    top: 108px;
    width: 524px;
    height: 70px;
    color: rgba(18, 7, 3, 0.90);
    -unity-text-align: middle-center;
}

.settings-title {
    position: absolute;
    left: 695px;
    top: 102px;
    width: 530px;
    height: 70px;
