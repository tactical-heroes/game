.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 260ms;
    transition-timing-function: ease-in-out;
}

.screen-hidden {
    opacity: 0;
    translate: 0 18px;
}

.settings-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: #050403;
    background-image: url("../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Images/menu_background.png");
    -unity-background-scale-mode: scale-and-crop;
}

.settings-dark-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.18);
}

.settings-logo {
    position: absolute;
    left: 910px;
    top: 12px;
    width: 100px;
    height: 100px;
    background-image: url("../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Images/menu_logo_emblem.png");
    -unity-background-scale-mode: scale-to-fit;
}

.settings-title-shadow {
    position: absolute;
    left: 698px;
    top: 108px;
    width: 524px;
    height: 70px;
    color: rgba(18, 7, 3, 0.90);
    -unity-text-align: middle-center;
}

.settings-title {
    position: absolute;
    left: 695px;
    top: 102px;
    width: 530px;
    height: 70px;
    color: #facc47;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(255, 242, 173, 0.38);
    -unity-text-align: middle-center;
    text-shadow: 0 4px 6px rgba(0, 0, 0, 0.78);
}

.settings-title-separator {
    position: absolute;
    left: 713px;
    top: 157px;
    width: 494px;
    height: 50px;
    background-image: url("../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Images/menu_title_separator.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.settings-subtitle {
    position: absolute;
    left: 713px;
    top: 195px;
    width: 494px;
    height: 30px;
    color: #dbc28f;
    font-size: 20px;
    -unity-font-definition: url("../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Fonts/CormorantGaramond-Medium.otf");
    -unity-text-align: middle-center;
    letter-spacing: 0.6px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.58);
}

.settings-navigation {
    position: absolute;
    left: 76px;
    top: 230px;
    width: 330px;
    height: 716px;
}

.settings-panels {
    position: absolute;
    left: 434px;
    top: 230px;
    width: 1410px;
    height: 716px;
}

.settings-card {
    position: absolute;
    width: 690px;
}

.settings-card-large {
    height: 372px;
}

.settings-card-small {
    height: 320px;
}

.settings-card-display {
    left: 0;
    top: 0;
}

.settings-card-quality {
    left: 720px;
    top: 0;
}

.settings-card-audio {
    left: 0;
    top: 396px;
}

.settings-card-gameplay {
    left: 720px;
    top: 396px;
}

.settings-navigation .th-panel-background,
.settings-card .th-panel-background {
    background-color: rgba(8, 6, 4, 0.58);
}

.settings-navigation .th-panel-shadow,
.settings-card .th-panel-shadow {
    background-color: rgba(0, 0, 0, 0.14);
}

.settings-navigation .th-panel-border,
.settings-card .th-panel-border {
    border-left-color: rgba(127, 82, 32, 0.62);
    border-right-color: rgba(127, 82, 32, 0.62);
    border-top-color: rgba(127, 82, 32, 0.62);
    border-bottom-color: rgba(127, 82, 32, 0.62);
}

.settings-navigation .th-panel-corner,
.settings-card .th-panel-corner {
    width: 50px;
    height: 50px;
    opacity: 0.78;
}

.settings-navigation-button {
    position: absolute;
    left: 22px;
    top: 30px;
    width: 286px;
    height: 50px;
}

.settings-navigation-button .th-button__label-stack {
    left: 34px;
    right: 34px;
}

.settings-navigation-button .th-button__label-layer {
