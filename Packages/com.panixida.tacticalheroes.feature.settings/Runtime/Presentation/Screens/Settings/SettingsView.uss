.settings-button-glow {
    display: none;
    position: absolute;
    left: 18px;
    top: 7px;
    width: 354px;
    height: 53px;
    background-image: url("../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Images/menu_button_selected_glow.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.settings-action-button-label {
    position: absolute;
    left: 0;
    top: 13px;
    width: 390px;
    height: 42px;
    color: #dbc79e;
    font-size: 26px;
    -unity-font-definition: url("../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Fonts/CormorantGaramond-SemiBold.otf");
    -unity-text-align: middle-center;
    letter-spacing: 2.08px;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.70);
}

.settings-action-button-label-long {
    font-size: 23px;
    letter-spacing: 1.38px;
}

.settings-action-button:hover .settings-button-tint,
.settings-action-button.selected .settings-button-tint {
    background-color: rgba(0, 0, 0, 0);
}

.settings-action-button:hover .settings-button-glow,
.settings-action-button.selected .settings-button-glow {
    display: flex;
}

.settings-action-button:hover .settings-action-button-label,
.settings-action-button.selected .settings-action-button-label {
    color: #ffe5a8;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.82);
}
