.th-icon-button {
    position: relative;
    width: 68px;
    height: 68px;
    min-width: 0;
    min-height: 0;
    background-image: url("../../Images/Buttons/square_icon_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: #ffffff;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    overflow: hidden;
}

.th-icon-button:hover,
.th-icon-button:active,
.th-icon-button:focus,
.th-icon-button:disabled {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.th-icon-button:hover {
    -unity-background-image-tint-color: #ffffff;
}

.th-icon-button:active {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.82);
}

.th-icon-button:disabled {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.54);
}

.th-icon-button__hover-glow,
.th-icon-button__selected-glow,
.th-icon-button__active-tint,
.th-icon-button__disabled-tint {
    display: none;
    position: absolute;
    left: 12%;
    top: 12%;
    right: 12%;
    bottom: 12%;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
}

.th-icon-button__hover-glow {
    background-color: rgba(255, 184, 46, 0.11);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 184, 56, 0.42);
    border-right-color: rgba(255, 184, 56, 0.42);
    border-top-color: rgba(255, 184, 56, 0.42);
    border-bottom-color: rgba(255, 184, 56, 0.42);
}

.th-icon-button__selected-glow {
    background-color: rgba(255, 173, 41, 0.18);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 199, 64, 0.64);
    border-right-color: rgba(255, 199, 64, 0.64);
    border-top-color: rgba(255, 199, 64, 0.64);
    border-bottom-color: rgba(255, 199, 64, 0.64);
}

.th-icon-button__active-tint {
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.24);
}

.th-icon-button__disabled-tint {
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.42);
}

.th-icon-button:hover .th-icon-button__hover-glow,
.th-icon-button:focus .th-icon-button__hover-glow {
    display: flex;
}

.th-icon-button:active .th-icon-button__hover-glow {
    display: none;
}

.th-icon-button:active .th-icon-button__active-tint {
    display: flex;
}

.th-icon-button.th-icon-button--selected .th-icon-button__selected-glow {
    display: flex;
}

.th-icon-button:disabled .th-icon-button__hover-glow,
.th-icon-button:disabled .th-icon-button__selected-glow,
.th-icon-button:disabled .th-icon-button__active-tint {
    display: none;
}

.th-icon-button:disabled .th-icon-button__disabled-tint {
    display: flex;
}

.th-icon-button__icon {
    position: absolute;
    left: 20%;
    top: 20%;
    width: 60%;
    height: 60%;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #ffffff;
}

.th-icon-button:active .th-icon-button__icon {
    translate: 0 1px;
}

.th-icon-button:disabled .th-icon-button__icon {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.68);
}

.th-icon-button__icon--discord {
    background-image: url("../../Images/Icons/Communication/discord.png");
}

.th-icon-button__icon--support {
    background-image: url("../../Images/Icons/Communication/technical_support.png");
}

.th-icon-button__icon--settings {
    background-image: url("../../Images/Icons/Common/settings.png");
}

.th-icon-button__icon--send-message {
    background-image: url("../../Images/Icons/Communication/send_message.png");
}

.th-icon-button__icon--leaderboards {
    background-image: url("../../Images/Icons/Actions/leaderboards.png");
}

.th-icon-button__icon--match-history {
    background-image: url("../../Images/Icons/Actions/match_history.png");
}

.th-icon-button__icon--back {
    background-image: url("../../Images/Icons/Actions/back.png");
}
