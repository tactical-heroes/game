<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:foundation="Panixida.TacticalHeroes.Foundation.Presentation.Components" editor-extension-mode="False">
    <Style src="../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Typography/Typography.uss" />
    <Style src="../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Components/DecorativePanel/DecorativePanel.uss" />
    <Style src="../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Components/GameButton/GameButtonView.uss" />
    <Style src="AuthorizationView.uss" />
    <ui:Template name="DecorativePanelChrome" src="../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Components/DecorativePanel/DecorativePanelChrome.uxml" />
    <ui:VisualElement name="authorization-root" class="screen authorization-root screen-hidden">
        <ui:VisualElement class="auth-dark-overlay" />
        <ui:VisualElement class="auth-readability-panel" />

        <ui:VisualElement name="auth-sign-in-page" class="auth-page auth-sign-in-page">
            <ui:VisualElement class="auth-panel auth-sign-in-panel th-panel">
                <ui:Instance template="DecorativePanelChrome" class="th-panel-chrome" />
                <ui:VisualElement class="auth-panel-vignette" />
                <ui:VisualElement class="auth-logo" />

                <ui:VisualElement class="auth-title-stack auth-sign-in-title-stack">
                    <ui:Label class="auth-title-layer auth-title-shadow typography-display-main-title" text="SIGN IN" />
                    <ui:Label class="auth-title-layer auth-title-glow typography-display-main-title" text="SIGN IN" />
                    <ui:Label class="auth-title-layer auth-title-main typography-display-main-title" text="SIGN IN" />
                    <ui:Label class="auth-title-layer auth-title-highlight typography-display-main-title" text="SIGN IN" />
                </ui:VisualElement>
                <ui:VisualElement class="auth-title-separator auth-sign-in-title-separator" />
                <ui:Label class="auth-subtitle auth-sign-in-subtitle" text="Access your tactical command center" />

                <ui:VisualElement class="auth-field auth-sign-in-email-field">
                    <ui:Label class="auth-field-label" text="Email" />
                    <ui:TextField name="auth-sign-in-email-input" class="auth-text-input" />
                    <ui:Label class="auth-placeholder" text="commander@example.com" />
                    <ui:Label class="auth-validation-message screen-hidden" text="Enter a valid email address" />
                </ui:VisualElement>

                <ui:VisualElement class="auth-field auth-sign-in-password-field">
                    <ui:Label class="auth-field-label" text="Password" />
                    <ui:TextField name="auth-sign-in-password-input" class="auth-text-input auth-password-input" />
                    <ui:Label class="auth-placeholder" text="Password" />
                    <ui:Button name="auth-sign-in-password-visibility-button" class="auth-eye-button">
                        <ui:VisualElement class="auth-eye-icon" />
                    </ui:Button>
                    <ui:Label class="auth-validation-message screen-hidden" text="Enter your password" />
                </ui:VisualElement>

                <ui:VisualElement class="auth-option-row auth-remember-row">
                    <ui:Button name="auth-remember-checkbox" class="auth-checkbox" />
                    <ui:Label class="auth-option-label" text="Remember me" />
                    <ui:Button name="auth-forgot-password-button" class="auth-link-button" text="Forgot password?" />
                </ui:VisualElement>

                <foundation:GameButtonView name="auth-sign-in-submit-button" class="auth-button auth-sign-in-submit-button" label="SIGN IN" />
                <foundation:GameButtonView name="auth-show-create-account-button" class="auth-button auth-show-create-account-button" label="CREATE ACCOUNT" />
                <foundation:GameButtonView name="auth-sign-in-back-button" class="auth-button auth-sign-in-back-button" label="BACK" />

                <ui:VisualElement class="auth-footer-ornament auth-footer-ornament-left" />
                <ui:VisualElement class="auth-footer-ornament auth-footer-ornament-right" />
                <ui:Label class="auth-version-label" text="PRE-ALPHA v0.1.0" />
            </ui:VisualElement>

            <ui:VisualElement class="auth-footer-links">
                <ui:Button name="auth-sign-in-discord-button" class="auth-icon-button auth-icon-button-discord">
                    <ui:VisualElement class="auth-icon-button-overlay auth-icon-button-hover-glow" />
                    <ui:VisualElement class="auth-icon-button-overlay auth-icon-button-selected-glow" />
                    <ui:VisualElement class="auth-icon-button-overlay auth-icon-button-active-tint" />
                    <ui:VisualElement class="auth-icon-button-overlay auth-icon-button-disabled-tint" />
                </ui:Button>
                <ui:Button name="auth-sign-in-support-button" class="auth-icon-button auth-icon-button-support">
                    <ui:VisualElement class="auth-icon-button-overlay auth-icon-button-hover-glow" />
                    <ui:VisualElement class="auth-icon-button-overlay auth-icon-button-selected-glow" />
                    <ui:VisualElement class="auth-icon-button-overlay auth-icon-button-active-tint" />
                    <ui:VisualElement class="auth-icon-button-overlay auth-icon-button-disabled-tint" />
                </ui:Button>
                <ui:Button name="auth-sign-in-settings-button" class="auth-icon-button auth-icon-button-settings">
                    <ui:VisualElement class="auth-icon-button-overlay auth-icon-button-hover-glow" />
                    <ui:VisualElement class="auth-icon-button-overlay auth-icon-button-selected-glow" />
                    <ui:VisualElement class="auth-icon-button-overlay auth-icon-button-active-tint" />
                    <ui:VisualElement class="auth-icon-button-overlay auth-icon-button-disabled-tint" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="auth-create-account-page" class="auth-page auth-create-account-page screen-hidden">
            <ui:VisualElement class="auth-panel auth-create-account-panel th-panel">
                <ui:Instance template="DecorativePanelChrome" class="th-panel-chrome" />
                <ui:VisualElement class="auth-panel-vignette" />
                <ui:VisualElement class="auth-logo auth-create-logo" />

                <ui:VisualElement class="auth-title-stack auth-create-title-stack">
                    <ui:Label class="auth-title-layer auth-title-shadow typography-display-main-title" text="CREATE ACCOUNT" />
                    <ui:Label class="auth-title-layer auth-title-glow typography-display-main-title" text="CREATE ACCOUNT" />
                    <ui:Label class="auth-title-layer auth-title-main typography-display-main-title" text="CREATE ACCOUNT" />
                    <ui:Label class="auth-title-layer auth-title-highlight typography-display-main-title" text="CREATE ACCOUNT" />
                </ui:VisualElement>
                <ui:VisualElement class="auth-title-separator auth-create-title-separator" />
                <ui:Label class="auth-subtitle auth-create-subtitle" text="Begin your campaign with a new account" />

                <ui:VisualElement class="auth-field auth-create-login-field">
                    <ui:Label class="auth-field-label" text="Login" />
                    <ui:TextField name="auth-create-login-input" class="auth-text-input" />
                    <ui:Label class="auth-placeholder" text="Commander name" />
                    <ui:Label class="auth-validation-message screen-hidden" text="Enter a login" />
                </ui:VisualElement>

                <ui:VisualElement class="auth-field auth-create-email-field">
                    <ui:Label class="auth-field-label" text="Email" />
                    <ui:TextField name="auth-create-email-input" class="auth-text-input" />
                    <ui:Label class="auth-placeholder" text="commander@example.com" />
                    <ui:Label class="auth-validation-message screen-hidden" text="Enter a valid email address" />
                </ui:VisualElement>

                <ui:VisualElement class="auth-field auth-create-password-field">
                    <ui:Label class="auth-field-label" text="Password" />
                    <ui:TextField name="auth-create-password-input" class="auth-text-input auth-password-input" />
                    <ui:Label class="auth-placeholder" text="Password" />
                    <ui:Button name="auth-create-password-visibility-button" class="auth-eye-button">
                        <ui:VisualElement class="auth-eye-icon" />
                    </ui:Button>
                    <ui:Label class="auth-validation-message screen-hidden" text="Enter your password" />
                </ui:VisualElement>

                <ui:VisualElement class="auth-field auth-create-confirm-password-field">
                    <ui:Label class="auth-field-label" text="Confirm Password" />
                    <ui:TextField name="auth-create-confirm-password-input" class="auth-text-input auth-password-input" />
                    <ui:Label class="auth-placeholder" text="Repeat password" />
                    <ui:Button name="auth-create-confirm-password-visibility-button" class="auth-eye-button">
                        <ui:VisualElement class="auth-eye-icon" />
                    </ui:Button>
                    <ui:Label class="auth-validation-message screen-hidden" text="Passwords must match" />
                </ui:VisualElement>

                <ui:VisualElement class="auth-option-row auth-terms-row">
                    <ui:Button name="auth-terms-checkbox" class="auth-checkbox" />
                    <ui:Label class="auth-option-label auth-terms-label" text="I accept the Terms of Service and Privacy Policy" />
                </ui:VisualElement>

                <foundation:GameButtonView name="auth-create-account-submit-button" class="auth-button auth-create-account-submit-button" label="CREATE ACCOUNT" />
                <foundation:GameButtonView name="auth-back-to-sign-in-button" class="auth-button auth-back-to-sign-in-button" label="BACK TO SIGN IN" />

                <ui:VisualElement class="auth-footer-ornament auth-footer-ornament-left" />
                <ui:VisualElement class="auth-footer-ornament auth-footer-ornament-right" />
                <ui:Label class="auth-version-label" text="PRE-ALPHA v0.1.0" />
            </ui:VisualElement>

            <ui:VisualElement class="auth-footer-links auth-create-footer-links">
                <ui:Button name="auth-create-discord-button" class="auth-icon-button auth-icon-button-discord">
                    <ui:VisualElement class="auth-icon-button-overlay auth-icon-button-hover-glow" />
                    <ui:VisualElement class="auth-icon-button-overlay auth-icon-button-selected-glow" />
                    <ui:VisualElement class="auth-icon-button-overlay auth-icon-button-active-tint" />
                    <ui:VisualElement class="auth-icon-button-overlay auth-icon-button-disabled-tint" />
                </ui:Button>
                <ui:Button name="auth-create-support-button" class="auth-icon-button auth-icon-button-support">
                    <ui:VisualElement class="auth-icon-button-overlay auth-icon-button-hover-glow" />
                    <ui:VisualElement class="auth-icon-button-overlay auth-icon-button-selected-glow" />
                    <ui:VisualElement class="auth-icon-button-overlay auth-icon-button-active-tint" />
                    <ui:VisualElement class="auth-icon-button-overlay auth-icon-button-disabled-tint" />
                </ui:Button>
                <ui:Button name="auth-create-settings-button" class="auth-icon-button auth-icon-button-settings">
                    <ui:VisualElement class="auth-icon-button-overlay auth-icon-button-hover-glow" />
                    <ui:VisualElement class="auth-icon-button-overlay auth-icon-button-selected-glow" />
                    <ui:VisualElement class="auth-icon-button-overlay auth-icon-button-active-tint" />
                    <ui:VisualElement class="auth-icon-button-overlay auth-icon-button-disabled-tint" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
