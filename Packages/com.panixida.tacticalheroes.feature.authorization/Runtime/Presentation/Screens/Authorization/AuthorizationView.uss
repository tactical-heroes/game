.auth-icon-button {
    position: absolute;
    top: 0;
    width: 54px;
    height: 54px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #ffffff;
    border-radius: 2px;
    overflow: hidden;
}

.auth-icon-button:hover,
.auth-icon-button:active,
.auth-icon-button:focus,
.auth-icon-button:disabled {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.auth-icon-button:hover {
    -unity-background-image-tint-color: #ffffff;
}

.auth-icon-button:active {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.82);
}

.auth-icon-button:disabled {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.62);
}

.auth-icon-button-overlay {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 2px;
    background-color: rgba(0, 0, 0, 0);
}

.auth-icon-button-hover-glow {
    left: 8px;
    top: 8px;
    right: 8px;
    bottom: 8px;
    border-radius: 3px;
    background-color: rgba(255, 184, 46, 0.11);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 184, 56, 0.42);
    border-right-color: rgba(255, 184, 56, 0.42);
    border-top-color: rgba(255, 184, 56, 0.42);
    border-bottom-color: rgba(255, 184, 56, 0.42);
}

.auth-icon-button-selected-glow {
    left: 6px;
    top: 6px;
    right: 6px;
    bottom: 6px;
    border-radius: 3px;
    background-color: rgba(255, 173, 41, 0.18);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 199, 64, 0.64);
    border-right-color: rgba(255, 199, 64, 0.64);
    border-top-color: rgba(255, 199, 64, 0.64);
    border-bottom-color: rgba(255, 199, 64, 0.64);
}

.auth-icon-button-active-tint {
    background-color: rgba(0, 0, 0, 0.24);
}

.auth-icon-button-disabled-tint {
    background-color: rgba(0, 0, 0, 0.42);
}

.auth-icon-button:hover .auth-icon-button-hover-glow {
    display: flex;
}

.auth-icon-button:active .auth-icon-button-hover-glow {
    display: none;
}

.auth-icon-button:active .auth-icon-button-active-tint {
    display: flex;
}

.auth-icon-button.auth-icon-button--selected .auth-icon-button-selected-glow {
    display: flex;
}

.auth-icon-button:disabled .auth-icon-button-hover-glow,
.auth-icon-button:disabled .auth-icon-button-selected-glow,
.auth-icon-button:disabled .auth-icon-button-active-tint {
    display: none;
}

.auth-icon-button:disabled .auth-icon-button-disabled-tint {
    display: flex;
}

.auth-icon-button-discord {
    left: 0;
    background-image: url("../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Images/ui_icon_button_discord.png");
}

.auth-icon-button-support {
    left: 68px;
    background-image: url("../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Images/ui_icon_button_support.png");
}

.auth-icon-button-settings {
