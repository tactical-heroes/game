.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 260ms;
    transition-timing-function: ease-in-out;
}

.screen-hidden {
    opacity: 0;
    translate: 0 18px;
}

.authorization-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: #080705;
    background-image: url("../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Images/menu_background.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.auth-dark-overlay {
    position: absolute;
