.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 260ms;
    transition-timing-function: ease-in-out;
}

.screen-hidden {
    opacity: 0;
    translate: 0 18px;
}

.lobby-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: #050302;
}

.lobby-background,
.lobby-dark-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

.lobby-background {
    background-image: url("../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Images/Backgrounds/realm_battlefield.png");
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: #ffffff;
}

.lobby-dark-overlay {
    background-color: rgba(0, 0, 0, 0.18);
}

.lobby-content {
    position: absolute;
    left: 0;
    top: 0;
    width: 1920px;
    height: 1080px;
}

.lobby-header {
    position: absolute;
    left: 0;
    top: 0;
    width: 1920px;
    height: 288px;
}

.lobby-logo {
    position: absolute;
    left: 910px;
    top: 12px;
    width: 100px;
    height: 100px;
    background-image: url("../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Images/Brand/tactical_heroes_emblem.png");
    -unity-background-scale-mode: scale-to-fit;
}

.lobby-title {
    position: absolute;
    left: 510px;
    top: 102px;
    width: 900px;
    height: 70px;
    font-size: 46px;
    -unity-font-definition: url("../../../../../com.panixida.tacticalheroes.foundation/Runtime/Presentation/Fonts/Cinzel-Bold.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    letter-spacing: 1.84px;
}

.lobby-title-shadow {
    left: 513px;
    top: 108px;
    color: rgba(18, 7, 3, 0.90);
}

.lobby-title-glow {
    color: rgba(255, 179, 31, 0.24);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(255, 179, 31, 0.18);
    text-shadow: 0 0 7px rgba(255, 179, 31, 0.24);
}

.lobby-title-main {
    color: #facc47;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(255, 242, 173, 0.38);
